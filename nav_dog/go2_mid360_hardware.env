# Unitree Go2 EDU + Livox MID-360 navigation hardware defaults.
#
# MID-360 is mounted at the front/top head area, tilted down about 13 degrees.
# sensorOffsetX/Y describe the LiDAR origin relative to the localPlanner
# "vehicle" body center. They are not LIO extrinsics and do not include pitch.
#
# Baseline x = 0.16143 m comes from the public Go2 + MID-360 URDF chain:
#   base_link -> imu (-0.02557, 0, 0.04232)
#   imu -> livox_frame (0.1870, 0, 0.0803), pitch 0.22689 rad
# x = -0.02557 + 0.1870 = 0.16143 m
# An independent Go2 MID-360 mount model uses 0.163 m; one measured real robot
# reports 0.187 m. Therefore treat 0.16143 m as a model baseline and override
# it with the robot's measured value when available.
#
# All launch paths consume these variables, so both localPlanner/pathFollower
# and the waypoint hold bridge always receive the same offset.
GO2_LIDAR_MODEL="${GO2_LIDAR_MODEL:-Livox MID-360}"
GO2_MID360_SENSOR_OFFSET_X="${GO2_MID360_SENSOR_OFFSET_X:-0.16143}"
GO2_MID360_SENSOR_OFFSET_Y="${GO2_MID360_SENSOR_OFFSET_Y:-0.0}"
GO2_MAX_SPEED="${GO2_MAX_SPEED:-0.5}"

export GO2_LIDAR_MODEL
export GO2_MID360_SENSOR_OFFSET_X
export GO2_MID360_SENSOR_OFFSET_Y
export GO2_MAX_SPEED
export SENSOR_OFFSET_X="${SENSOR_OFFSET_X:-$GO2_MID360_SENSOR_OFFSET_X}"
export SENSOR_OFFSET_Y="${SENSOR_OFFSET_Y:-$GO2_MID360_SENSOR_OFFSET_Y}"
export FAR_SENSOR_OFFSET_X="${FAR_SENSOR_OFFSET_X:-$SENSOR_OFFSET_X}"
export FAR_SENSOR_OFFSET_Y="${FAR_SENSOR_OFFSET_Y:-$SENSOR_OFFSET_Y}"
